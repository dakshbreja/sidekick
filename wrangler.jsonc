{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "school-bridge-community-dev",
  "main": "src/index.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_names": false,
  "minify": false,
  "observability": {"enabled": true, "head_sampling_rate": 1, "redact_query_string": true, "logs": {"enabled": true, "invocation_logs": false}, "traces": {"enabled": false}},
  "durable_objects": {"bindings": [{"name": "STUDENTS", "class_name": "StudentState"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["StudentState"]}],
  "vars": {"APP_ENV": "development", "ACCESS_ISSUER": "", "ACCESS_AUDIENCE": ""}
}

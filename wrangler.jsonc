{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "school-bridge-community-dev",
  "main": "src/index.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": true, "head_sampling_rate": 1},
  "durable_objects": {"bindings": [{"name": "STUDENTS", "class_name": "StudentState"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["StudentState"]}],
  "vars": {"APP_ENV": "development", "ACCESS_ISSUER": "", "ACCESS_AUDIENCE": ""}
}
